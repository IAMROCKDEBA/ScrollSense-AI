# YouTube Data API v3 key (server-side only). Without it the feed falls back to the seeded offline Shorts pool.
YOUTUBE_API_KEY=

# Anthropic API key (server-side only). Without it the AI features run in scripted "offline coach" mode.
ANTHROPIC_API_KEY=

# Optional model overrides. Defaults: claude-opus-5-5. Cheaper/faster options: claude-sonnet-5-5, claude-haiku-5-5
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_FAST_MODEL=claude-opus-5-5
